{
  "info": {
    "_postman_id": "bc947a16-8316-4d02-a15f-d8c67bf6f373",
    "name": "Bridge RESO Web Agents Metadata API",
    "description": "RESO Platinum-certified Web API for MLS listing data, served by Bridge (a Zillow Group company).\nData is normalized to the RESO Data Dictionary and queryable via OData 4.0. Bridge interprets\nOData `$top` as page size (default 10, max 200 via the `maxpagesize` header) and extends the spec\nwith an `unselect` parameter that returns all fields except those listed.\n\nEach request is scoped to a `{dataset}` (the MLS dataset code) and must carry an `access_token` \u2014\neither as a query parameter or via the `Authorization: Bearer` header.\n\n\nContact Support:\n Name: Bridge Interactive Support\n Email: support@bridgeinteractive.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T01:16:07.000Z",
    "updatedAt": "2026-07-28T01:16:07.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-bc947a16-8316-4d02-a15f-d8c67bf6f373"
  },
