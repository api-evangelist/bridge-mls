              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "description": "Preferred page size (default 10, max 200).",
                    "key": "maxpagesize",
                    "value": "10"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/:dataset/Property?$filter=<string>&$select=<string>&unselect=<string>&$expand=<string>&$orderby=<string>&$top=10&$skip=<integer>&$count=<boolean>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    ":dataset",
                    "Property"
                  ],
                  "query": [
                    {
                      "description": "OData filter expression (e.g. `ListPrice gt 500000 and StandardStatus eq 'Active'`).",
                      "key": "$filter",
                      "value": "<string>"
                    },
                    {
                      "description": "Comma-separated list of fields to return.",
                      "key": "$select",
                      "value": "<string>"
                    },
                    {
                      "description": "Bridge extension \u2014 comma-separated list of fields to exclude (returns all other fields).",
                      "key": "unselect",
                      "value": "<string>"
                    },
                    {
                      "description": "Comma-separated list of navigation properties to expand (e.g. `Media,Rooms`). Default max 10 results per expand unless `$top` is specified inside the expand.",
                      "key": "$expand",
                      "value": "<string>"
                    },
                    {
                      "description": "Sort expression (e.g. `ModificationTimestamp desc`).",
                      "key": "$orderby",
                      "value": "<string>"
                    },
                    {
                      "description": "Page size. Bridge interprets `$top` as page size (not total collection size). Default 10, max 200.",
                      "key": "$top",
                      "value": "10"
                    },
                    {
                      "description": "Number of records to skip.",
                      "key": "$skip",
                      "value": "<integer>"
                    },
                    {
                      "description": "Include `@odata.count` in the response.",
                      "key": "$count",
                      "value": "<boolean>"
                    }
                  ],
                  "variable": [
                    {
                      "id": "14887e27-725c-4da5-be81-0198227d77d8",
                      "key": "dataset",
                      "value": "<string>",
                      "description": "(Required) MLS dataset code (e.g. `test`, `actris_ref`, `mlspin`)."
                    }
                  ]
                },
                "description": "Query the Property entity set with OData query options. Returns RESO-normalized listing records including embedded Media."
