  "info": {
    "_postman_id": "347a5bf0-98c3-4bb6-bd08-cb5e6c6156b5",
    "name": "Bridge Webhooks API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Manage webhook endpoints that receive real-time POST events from Bridge for listing change events.\nEndpoints require an HTTPS URL with a valid X.509 certificate; Bridge issues a PKI public key\n(PEM) for payload signature verification. Failed deliveries retry with exponential backoff for\nup to two days. New endpoints start disabled for testing before activation.\n",
      "type": "text/plain"
    }
  }
