              }
            ]
          },
          "docs": "List Offices"
        }
      ]
    },
    {
      "info": {
        "name": "OpenHouses",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Open Houses",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bridgedataoutput.com/api/v2/:dataset/openhouses",
            "params": [
              {
                "name": "dataset",
                "value": "",
