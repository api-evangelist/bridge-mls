    {
      "info": {
        "name": "Media",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Media",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bridgedataoutput.com/api/v2/OData/:dataset/Media",
            "params": [
              {
