            "params": [
              {
                "name": "dataset",
                "value": "",
                "type": "path",
                "description": "MLS dataset code (e.g. `test`, `actris_ref`, `mlspin`)."
              },
              {
                "name": "officeKey",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Office By Key"
        }
      ]
    },
    {
      "info": {
        "name": "OpenHouse",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Open Houses",
            "type": "http"
          },
          "http": {
